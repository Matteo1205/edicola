# Esempio di variabili d'ambiente per l'applicazione Edicola.
# Copia questo file in .env e personalizza i valori prima di eseguire l'app.

# Secret key usata da Flask per sessioni e sicurezza. Cambia in produzione!
SECRET_KEY=dev-secret-key-cambia-in-produzione

# PostgreSQL: definire le componenti separate (HOST/PORT/USER/PASSWORD/NAME)
DATABASE_HOST = localhost
DATABASE_PORT = 5432
DATABASE_NAME = edicola
DATABASE_USER = nome_utente
DATABASE_PASSWORD = password_utente

# Opzionale: debug mode per Flask (1 per attivare, 0 per disattivare)
FLASK_DEBUG=1