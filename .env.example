# Esempio di variabili d'ambiente per l'applicazione Edicola.
# Copia questo file in .env e personalizza i valori prima di eseguire l'app.

# Condigurazione database PostgreSQL
DATABASE_HOST = localhost
DATABASE_PORT = your_port_here
DATABASE_NAME = your_db_name_here
DATABASE_USER = your_db_user_here
DATABASE_PASSWORD = your_db_password_here

# Secret key usata da Flask per sessioni e sicurezza. Cambia in produzione!
SECRET_KEY = dev-secret-key-cambia-in-produzione

# Opzionale
FLASK_ENV = ...         # Ambiente di esecuzione (development, production, etc.)
FLASK_DEBUG = ...       # Debug mode per Flask (1 per attivare, 0 per disattivare)